{
    "name": "matondojk/filament-data-copilot",
    "description": "An AI-powered data assistant for Filament PHP that turns natural language into charts and SQL reports.",
    "type": "filament-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "matondojk",
            "email": "matondojk@github.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "filament/filament": "^3.0",
        "illuminate/support": "^10.0|^11.0",
        "laravel-ai/laravel-ai": "*"
    },
    "autoload": {
        "psr-4": {
            "Matondojk\\FilamentDataCopilot\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Matondojk\\FilamentDataCopilot\\FilamentDataCopilotServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
